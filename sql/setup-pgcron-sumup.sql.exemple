-- ════════════════════════════════════════════════════════════════════
-- Synchro SumUp automatique — à exécuter dans Supabase → SQL Editor
-- ════════════════════════════════════════════════════════════════════
-- Sans ça, le chiffre d'affaires n'entre dans l'outil que si quelqu'un
-- pense à cliquer « Lancer la synchronisation ». Une synchro qu'on
-- déclenche à la main n'est pas une synchro : au premier coup de feu,
-- personne n'y pense, et le CA du jour est faux.
--
-- Pourquoi pas un cron Vercel : le plan Hobby plafonne à 2 tâches (déjà
-- prises par la collecte d'avis et les rappels de réservation) et ne les
-- exécute qu'une fois par jour. Ça ne fera jamais du temps réel.
--
-- pg_cron tourne dans Supabase, aussi souvent qu'on veut.
--
-- ⚠️ AVANT DE COLLER : remplacez <VOTRE_CRON_SECRET> par la valeur de
-- CRON_SECRET (Vercel → app-restaurant → Settings → Environment
-- Variables → CRON_SECRET → l'œil pour l'afficher).
--
-- Ce fichier est un EXEMPLE, sans secret. Une fois complété, ne le
-- committez pas : `sql/setup-pgcron-sumup.sql` est ignoré par git.
-- ════════════════════════════════════════════════════════════════════

create extension if not exists pg_cron;
create extension if not exists pg_net;

-- Rejouable : on retire l'ancienne planification avant d'en poser une neuve.
select cron.unschedule('sumup-sync')
 where exists (select 1 from cron.job where jobname = 'sumup-sync');

-- Toutes les 10 minutes. Assez fin pour que le CA du jour soit à jour quand
-- on regarde le tableau de bord, assez espacé pour ne pas marteler l'API
-- SumUp — chaque passage fait un appel de liste plus un appel par ticket.
--
-- `jours=1` : on ne rattrape que la journée. Les tickets déjà importés sont
-- ignorés (idempotence par source_caisse + ticket_externe), donc repasser
-- dessus ne double rien ; c'est juste inutile de redemander 7 jours toutes
-- les 10 minutes.
select cron.schedule(
  'sumup-sync',
  '*/10 * * * *',
  $$
  select net.http_post(
    url     := 'https://app-restaurant-livid.vercel.app/api/cron/caisse/sumup?jours=1',
    headers := jsonb_build_object(
      'Authorization', 'Bearer <VOTRE_CRON_SECRET>',
      'Content-Type',  'application/json'
    ),
    timeout_milliseconds := 55000
  );
  $$
);

-- ─── Vérification ────────────────────────────────────────────────────
select jobname, schedule, active from cron.job where jobname = 'sumup-sync';

-- Et, quelques minutes plus tard, pour voir si l'appel aboutit :
--   select status_code, count(*)
--     from net._http_response
--    where created > now() - interval '1 hour'
--    group by 1;
-- Tout code différent de 200 = synchro en panne.
