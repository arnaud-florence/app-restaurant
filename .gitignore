# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# claude code (skill régénérable via `npx uipro-cli init -a claude` ; settings locaux)
.claude/skills/
.claude/settings.local.json

# Téléchargements partiels (ex: vidéos en cours de DL)
*.crdownload

# Setup pg_cron contenant CRON_SECRET en clair (à régénérer si rotation)
sql/setup-pgcron-agents.sql
.env*

# Sauvegardes locales (contiennent des données prod, ne pas pousser)
/backups/

# Résultats de campagne E2E (screenshots + rapports JSON, artefacts locaux)
/e2e-results/


# Relevés de prix fournisseur : conditions NÉGOCIÉES, confidentielles.
# Le dépôt est public — ces fichiers restent sur le poste.
data/france-boissons-*.json
data/devis-*.pdf
data/felix-potin-*.json
data/catalogue-*.pdf
data/selection-*.csv
data/tarif-*.csv
data/*.xlsx
# ⚠️ Catalogues fournisseurs : documents commerciaux de tiers, et le dépôt est
# public. Les 16 PDF Gel Var pèsent 75 Mo à eux seuls — sans cette ligne ils
# partaient dans l'historique, d'où on ne les retire plus vraiment.
data/gelvar/
data/demande-tarif-*.csv
# ⚠️ Un message de demande de tarif porte NOS coûts d'achat en face des
# leurs — c'est l'argument de négociation, et il n'a rien à faire dans un
# dépôt public. Le brouillon reste sur le poste ; c'est le gérant qui envoie.
data/demande-*.txt
data/demande-*.csv
# Les listes de commande portent nos prix d'achat.
data/commande-*.csv
data/liste-*.csv
data/liste-*.txt
data/Demande de tarif*.xlsx
data/gineys/
data/catalogues/
data/france-boissons-*
data/relance-eurocash-*.csv
data/carte-boissons-marges.csv
data/mail-*.txt
data/demande-tarif-*.csv
data/commande-*.pdf

# Factures fournisseurs — pièces comptables, dépôt public.
data/facture-*.pdf
data/*_signed.pdf
