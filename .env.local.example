# Supabase — projet dédié à app-restaurant (PAS celui de monrestaurant)
# À récupérer dans Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Pour exécuter les migrations en CLI (optionnel)
# Project Settings → Database → Connection string (URI, Session pooler)
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
